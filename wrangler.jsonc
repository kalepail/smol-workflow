/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "smol-workflow",
    "main": "src/index.ts",
    "compatibility_date": "2026-11-16",
    "minify": true,
    "workers_dev": false,
    "routes": [
        {
            "pattern": "api.smol.xyz",
            "custom_domain": true
        }
    ],
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "preview_urls": false,
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
            "invocation_logs": true
        }
    },
    "workflows": [
        {
            "name": "smol-workflow",
            "binding": "WORKFLOW",
            "class_name": "Workflow"
        },
        {
            "name": "smol-tx-workflow",
            "binding": "TX_WORKFLOW",
            "class_name": "TxWorkflow"
        }
    ],
    /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
    // "placement": { "mode": "smart" },
    /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
    "ai": {
        "binding": "AI"
    },
    // WARNING: smol-search-index uses 9 of the 10 allowed Vectorize metadata indexes.
    // Adding another metadata index would hit the platform limit.
    // See docs/search-index-setup.md for the full list of indexed properties.
    "vectorize": [
        {
            "binding": "SMOL_SEARCH_INDEX",
            "index_name": "smol-search-index"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "DURABLE_OBJECT",
                "class_name": "SmolDurableObject"
            },
            {
                "name": "DO_STATE",
                "class_name": "SmolState"
            },
            {
                "name": "USER_QUOTA",
                "class_name": "UserQuotaDO"
            }
        ]
    },
    "queues": {
        "producers": [
            {
                "queue": "smol-search-queue",
                "binding": "SEARCH_QUEUE",
                "delivery_delay": 0
            }
        ],
        "consumers": [
            {
                "queue": "smol-search-queue",
                "max_batch_size": 10,
                "max_batch_timeout": 5,
                "max_retries": 12,
                "dead_letter_queue": "smol-search-queue-dlq",
                "retry_delay": 5
            },
            {
                "queue": "smol-search-queue-dlq",
                "max_batch_size": 5,
                "max_batch_timeout": 10,
                "max_retries": 3
            }
        ]
    },
    /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   */
    "vars": {
        "RPC_URL": "https://rpc.lightsail.network/",
        "NETWORK_PASSPHRASE": "Public Global Stellar Network ; September 2015",
        "SMOL_CONTRACT_ID": "CBRNUVLGFM5OYWAGZVGU7CTMP2UJLKZCLFY2ANUCK5UGKND6BBAA5PLA",
        // Mint kill switch (closed by default). Only the exact string "true" admits mints and lets
        // TxWorkflow sign; "false" keeps POST /mint/status and receipt reconciliation running.
        "MINT_SIGNING_ENABLED": "false",
        "CF_AI_GATEWAY_ID": "smol",
        "CF_AIG_BYOK_ALIAS": "default",
        "ELEVENLABS_OUTPUT_FORMAT": "mp3_44100_128",
        "ELEVENLABS_FALLBACK_ENABLED": "true",
        "DAILY_LIMIT_CLASSIC": "10",
        "DAILY_LIMIT_ELEVENLABS": "3",
        "BURST_LIMIT_PER_MINUTE": "5",
        "GLOBAL_DAILY_LIMIT_CLASSIC": "500",
        "GLOBAL_DAILY_LIMIT_ELEVENLABS": "20",
        "PLAY_COUNT_MODE": "beacon",
        "MIXTAPE_DEDUPE_AI_ENABLED": "true",
        "SEARCH_BACKFILL_CRON_ENABLED": "true",
        "SEARCH_BACKFILL_CRON_PAGE_LIMIT": "20",
        "SEARCH_BACKFILL_CRON_STALL_RUNS": "6",
        "SEARCH_BACKFILL_CRON_MAX_WAVES": "5"
    },
    /**
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
    // Required Worker secrets: SECRET, SK, PIXELLAB_KEY, CF_API_TOKEN, CF_ZONE_ID, CF_AIG_TOKEN (and optional ADMIN_SECRET for admin routes; CF_AI_GATEWAY_ID var/secret for ElevenLabs BYOK).
    /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
    // "assets": { "directory": "./public/", "binding": "ASSETS" },
    /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
    "services": [
        {
            "binding": "AISONGGENERATOR",
            "service": "aisonggenerator-worker"
        },
        {
            "binding": "KALE_WORKER",
            "service": "kale-worker"
        }
    ],
    "migrations": [
        {
            "tag": "v1",
            "new_classes": [
                "SmolDurableObject"
            ]
        },
        {
            "tag": "v2",
            "new_classes": [
                "SmolState"
            ]
        },
        {
            "tag": "v3",
            "new_sqlite_classes": [
                "UserQuotaDO"
            ]
        }
    ],
    "triggers": {
        "crons": [
            "0 * * * *"
        ]
    },
    "r2_buckets": [
        {
            "binding": "SMOL_BUCKET",
            "bucket_name": "smol-r2"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "SMOL_KV",
            "id": "a42b9877d5c947e1917a2f0f56bbbc7f"
        }
    ],
    "d1_databases": [
        {
            "binding": "SMOL_D1",
            "database_name": "smol-d1",
            "database_id": "fd81569c-6984-4935-824f-efa4f79e247b"
        }
    ]
}
